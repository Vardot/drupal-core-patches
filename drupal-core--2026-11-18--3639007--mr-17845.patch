+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\locale\Kernel;
+
+use Drupal\KernelTests\KernelTestBase;
+use Drupal\language\Entity\ConfigurableLanguage;
+use Drupal\locale\Form\TranslateFilterForm;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests the language filter of the translate filter form.
+ */
+#[Group('locale')]
+#[RunTestsInSeparateProcesses]
+class TranslateFilterFormTest extends KernelTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = ['language', 'locale', 'system', 'user'];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->installConfig(['language', 'locale']);
+  }
+
+  /**
+   * Tests the language filter when no language is translatable.
+   */
+  public function testLanguageFilterWithoutTranslatableLanguage(): void {
+    $element = $this->buildLanguageFilter();
+    $this->assertSame('', $element['#empty_value']);
+    $this->assertSame(['' => '- None -'], $element['#options']);
+  }
+
+  /**
+   * Tests the language filter with a translatable language.
+   */
+  public function testLanguageFilterWithTranslatableLanguage(): void {
+    ConfigurableLanguage::createFromLangcode('fr')->save();
+    $element = $this->buildLanguageFilter();
+    $this->assertSame('fr', $element['#empty_value']);
+    $this->assertSame(['fr' => 'French'], $element['#options']);
+  }
+
+  /**
+   * Builds the filter form and returns its processed language filter.
+   *
+   * @return array
+   *   The language filter select element.
+   */
+  protected function buildLanguageFilter(): array {
+    $form = $this->container->get('form_builder')->getForm(TranslateFilterForm::class);
+    return $form['filters']['status']['langcode'];
+  }
+
+}
